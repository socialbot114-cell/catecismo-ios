    "Fonte: PDF da Diocese de Miracema. §§2217 e 2439 incluídos no texto offline.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Source: Diocese of Miracema PDF. §§2217 and 2439 are included in the offline text."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fuente: PDF de la Diócesis de Miracema. Los §§2217 y 2439 están incluidos en el texto sin conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Source : PDF du diocèse de Miracema. Les §§2217 et 2439 sont inclus dans le texte hors ligne."
          }
        }
      }
    },
    "EDIÇÃO EM PORTUGUÊS · %lld SEÇÕES": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PORTUGUESE EDITION · %lld SECTIONS"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "EDICIÓN EN PORTUGUÉS · %lld SECCIONES"
