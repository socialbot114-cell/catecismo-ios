    "Aplicativo independente e não oficial. Reúne guias autorais de introdução; não é o Catecismo completo nem substitui as fontes oficiais." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Independent and unofficial app with original introductory guides. It is not the complete Catechism and does not replace official sources." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Aplicación independiente y no oficial con guías introductorias originales. No es el Catecismo completo ni sustituye las fuentes oficiales." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Application indépendante et non officielle proposant des guides d’introduction originaux. Elle ne contient pas le Catéchisme complet et ne remplace pas les sources officielles." } } } },
    "Sua biblioteca, sempre com você" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Your library, always with you" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Tu biblioteca siempre contigo" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Votre bibliothèque, toujours avec vous" } } } },
