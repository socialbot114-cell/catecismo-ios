    <string name="about_title">Acerca de</string>
    <string name="about_guides">Guías originales de formación cristiana, inspiradas en la estructura del Catecismo y en fuentes oficiales. Funciona sin conexión y sin anuncios.</string>
    <string name="references_credits">Referencias y créditos: consulta los detalles de cada guía y la documentación del proyecto.</string>
    <string name="topic_creed">Credo</string>
    <string name="topic_creed_work">La profesión de fe</string>
    <string name="topic_creed_summary">Palabras que reúnen a la comunidad cristiana en una esperanza compartida.</string>
    <string name="topic_creed_story">Recorre los fundamentos de la fe cristiana con lenguaje claro, preguntas para reflexionar y referencias para profundizar.</string>
    <string name="topic_sacraments">Sacramentos</string>
    <string name="topic_sacraments_work">La vida de la gracia</string>
    <string name="topic_sacraments_summary">Signos celebrados que hacen visible la cercanía de Dios.</string>
    <string name="topic_sacraments_story">Conoce el sentido de los sacramentos y cómo la celebración continúa en decisiones de cuidado, servicio y comunión.</string>
    <string name="topic_prayer">Oración</string>
    <string name="topic_prayer_work">El encuentro con Dios</string>
    <string name="topic_prayer_summary">El silencio, la gratitud y la petición como caminos de presencia.</string>
    <string name="topic_prayer_story">Una escuela práctica para crear momentos de oración y escucha al ritmo de cada día.</string>
    <string name="topic_church">Iglesia</string>
    <string name="topic_church_work">Un pueblo en camino</string>
    <string name="topic_church_summary">Una comunidad diversa, reunida para celebrar y servir.</string>
    <string name="topic_church_story">Reflexiona sobre la pertenencia, los dones, la misión y el cuidado de las personas más vulnerables.</string>
    <string name="topic_mary">María</string>
    <string name="topic_mary_work">Un sí confiado</string>
    <string name="topic_mary_summary">Disponibilidad, valentía y cuidado de la vida.</string>
    <string name="topic_mary_story">Una meditación sobre María como mujer de fe y presencia fiel en el camino de Cristo.</string>
