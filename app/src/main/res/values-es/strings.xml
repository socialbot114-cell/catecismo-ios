    <string name="language_piox_facsimile">Facsímil · Internet Archive</string>
    <string name="language_piox_facsimile_note">La copia de Internet Archive indica que es una traducción no oficial con revisiones de 1976.</string>
    <string name="language_piox_italian">ITALIANO</string>
    <string name="language_piox_italian_title">Catechismo maggiore</string>
    <string name="language_piox_italian_summary">Edición de Roma, Tipografía Vaticana, 1905, transcrita por partes y capítulos en Wikisource.</string>
    <string name="language_piox_wikisource">Leer en Wikisource</string>
    <string name="language_piox_rights_note">Las fuentes se abren en el navegador y requieren conexión. El original de 1905 es de dominio público; los derechos de traducciones y transcripciones dependen de cada edición.</string>
    <string name="language_piox_offline_status">Las ediciones siguientes se abren en el navegador. Cada traducción necesita revisión y derechos de reutilización adecuados antes de distribuirse sin conexión.</string>
    <string name="piox_open_archive">Consultar en Internet Archive</string>
    <string name="piox_english_language">ENGLISH · 1911</string>
    <string name="piox_english_title">The Catechism of Pope Saint Pius X</string>
    <string name="piox_english_summary">Traducción de Father John Hagan. El libro digitalizado identifica una versión anterior de la época en que Pío X era obispo de Mantua, no la edición romana de 1905.</string>
    <string name="piox_english_note">Una nueva traducción inglesa de la edición romana de 1905 todavía requiere revisión editorial.</string>
    <string name="piox_spanish_language">ESPAÑOL · 1906</string>
    <string name="piox_spanish_title">Catecismo Mayor de San Pío X</string>
    <string name="piox_spanish_summary">Facsímil digitalizado de la edición castellana de 1906, con texto OCR.</string>
    <string name="piox_spanish_note">La edición digitalizada incluye una reserva editorial sobre reproducción; su uso sin conexión aún debe verificarse.</string>
    <string name="piox_french_language">FRANÇAIS · ÉDITION COMPLÈTE</string>
    <string name="piox_french_full_title">Catéchisme de la Doctrine chrétienne · 1905</string>
    <string name="piox_french_full_summary">Traducción francesa de la edición romana completa, indicada con 993 preguntas y respuestas.</string>
    <string name="piox_french_1912_language">FRANÇAIS · ÉDITION ABRÉGÉE</string>
    <string name="piox_french_1912_title">Catéchisme de Rome · 1912</string>
    <string name="piox_french_1912_summary">Edición abreviada, indicada con 433 preguntas y respuestas.</string>
    <string name="piox_french_1912_note">El archivo digital indica derechos de autor de 2008 y condiciones de uso no comercial.</string>
